# User configuration (auto-detected by make setup)
USER_ID=
GROUP_ID=
USER=
HOME_PATH=

# Project paths
FLUTTER_PROJECT_PATH=/home/<you>/workspace/<your-project>
# Mounted in the container: flutter/dart work in any directory below it (default: parent of this repo)
WORKSPACE_PATH=
# Set by make setup-env
SDK_PATH=

# DataWedge intent action of your app, used by make scan
SCAN_ACTION=

# DNS server used by the device with make tether (default: the laptop's current DNS server)
TETHER_DNS=
